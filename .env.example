# ============================================================
# Guild Insight — Vercel / 로컬 환경 변수 템플릿
# 복사: cp .env.example .env.local  (값은 Supabase/OpenAI 대시보드에서 발급)
# 절대 sb_secret_* / service_role 키를 NEXT_PUBLIC_* 변수에 넣지 마세요.
# ============================================================

# --- 배포 URL (Vercel OAuth 리다이렉트, 권장) ---
# NEXT_PUBLIC_SITE_URL=https://guildinsightapp.vercel.app

# --- Supabase (필수) ---
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings → API → anon / publishable key (클라이언트·RLS용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Project Settings → API → service_role / secret key (서버 전용, Vercel에만 설정)
# 로컬: SUPABASE_SERVICE_ROLE_KEY=sb_secret_... 또는 legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (GPT 리포트 생성, 선택) ---
# 없으면 로컬 fallback 리포트로 동작
OPENAI_API_KEY=
# 기본 gpt-4o-mini
OPENAI_REPORT_MODEL=gpt-4o-mini

# --- Google Cloud Vision (이미지 OCR, 선택) ---
# 로컬: JSON 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=google-vision-key.json
# Vercel: 서비스 계정 JSON 전체를 한 줄로 (권장)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# --- 개발 전용 (프로덕션 설정 금지) ---
# OCR 원문 디버그 로그 (길이만 출력, 전체 JSON 미출력)
# OCR_VISION_DEBUG=true
# 관리자 시드 API 허용
# ALLOW_SCORE_SEED=1
